# Copia este archivo a .env.local. Nunca se versiona .env.local.

# Postgres (ADR-0032). En local, `pnpm db:dev` levanta PGlite en este puerto.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# development | preview | production. En Vercel se usa VERCEL_ENV.
APP_ENV=development

# Key de InferHub solo para cheaptokens.wtf (ADR-0028). Opcional fuera de producción: sin ella se usa el mock.
UPSTREAM_INFERHUB_API_KEY=

# Upstream simulado (`pnpm mock:upstream`). Nunca en producción.
UPSTREAM_MOCK_BASE_URL=http://127.0.0.1:4010/v1

# Lo usa `pnpm catalog:sync` para revalidar el catálogo del sitio que corre en APP_URL. Mínimo 16 caracteres.
# En local se puede dejar vacío: el sync avisa que no revalidó y `next dev` no cachea el catálogo.
INTERNAL_REVALIDATE_SECRET=
APP_URL=http://localhost:3000

# Host del gateway en producción (api.cheaptokens.wtf). Vacío: cualquier host.
API_HOST=

# Rate limit global por workspace, requests por minuto (ADR-0017).
GATEWAY_RATE_LIMIT_RPM=60

# Clerk (ADR-0003, ADR-0050). Sin estas dos, `APP_ENV=development` entra con el modo de desarrollo y preview/producción no permiten iniciar sesión.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Firma del webhook `user.deleted` (POST /api/webhooks/clerk).
CLERK_WEBHOOK_SIGNING_SECRET=

# Puerta de socios (docs/17): el secreto con el que Deska llama a /partner/v1. Mínimo 32 caracteres; sin él, la puerta responde 401.
PARTNER_DESKA_SECRET=
