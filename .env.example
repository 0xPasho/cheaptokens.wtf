# Copia este archivo a .env.local. Nunca se versiona .env.local.

# Postgres (ADR-0032). En local, `pnpm db:dev` levanta PGlite en este puerto.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# development | preview | production. El servidor propio debe poner production (ADR-0059).
APP_ENV=development

# Keys de InferHub solo para cheapllm.wtf (ADR-0028). Opcional fuera de producción: sin ella se usa el mock.
# Varias cuentas: una key por cuenta, separadas por comas. El gateway rota entre ellas (ADR-0057).
UPSTREAM_INFERHUB_API_KEY=

# Upstream simulado (`pnpm mock:upstream`). Nunca en producción.
UPSTREAM_MOCK_BASE_URL=http://127.0.0.1:4010/v1

# Lo usa `pnpm catalog:sync` para revalidar el catálogo del sitio que corre en APP_URL. Mínimo 16 caracteres.
# En local se puede dejar vacío: el sync avisa que no revalidó y `next dev` no cachea el catálogo.
INTERNAL_REVALIDATE_SECRET=
APP_URL=http://localhost:3000
# Lo manda el cron del servidor (deploy/cron.sh) a /api/internal/* (ADR-0055, ADR-0059). Mínimo 16 caracteres.
CRON_SECRET=

# Host del gateway en producción (api.cheapllm.wtf). Vacío: cualquier host.
API_HOST=

# Rate limit global por workspace, requests por minuto (ADR-0017).
GATEWAY_RATE_LIMIT_RPM=60

# Clerk (ADR-0003, ADR-0050). Sin estas dos, `APP_ENV=development` entra con el modo de desarrollo y preview/producción no permiten iniciar sesión.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Firma del webhook `user.deleted` (POST /api/webhooks/clerk).
CLERK_WEBHOOK_SIGNING_SECRET=

# Puerta de socios (docs/17): el secreto con el que Deska llama a /partner/v1. Mínimo 32 caracteres; sin él, la puerta responde 401.
PARTNER_DESKA_SECRET=

# Pagos en USDC (ADR-0058). Cada cuenta tiene su dirección de depósito; lo que llega se barre a estas wallets.
# Sin semilla o sin wallets, `APP_ENV=development` muestra direcciones de ejemplo y deja simular el depósito.
#
# La semilla de la que salen las llaves de todas las direcciones de depósito. Es el único secreto de pagos:
# genérala con `pnpm payments:status --new-seed`, guárdala en un gestor de contraseñas y no la cambies nunca.
CRYPTO_DEPOSIT_SEED=
# La wallet principal de cada red: su dirección pública. Su llave privada nunca va aquí.
# Solana: tiene que haber recibido USDC al menos una vez (así existe su cuenta de USDC).
CRYPTO_SOLANA_ADDRESS=
# Un RPC propio (Helius, Triton…): el público de Solana limita mucho.
CRYPTO_SOLANA_RPC_URL=
# `devnet` para probar con USDC de prueba. Vacío: mainnet.
CRYPTO_SOLANA_CLUSTER=
# Base: con mayúsculas y minúsculas, tal como la muestra la wallet (la suma de control detecta un error al copiarla).
CRYPTO_BASE_ADDRESS=
# Un RPC propio (Alchemy, QuickNode…) o vacío para el público de Base.
CRYPTO_BASE_RPC_URL=
# `sepolia` para probar con USDC de prueba. Vacío: mainnet.
CRYPTO_BASE_CHAIN=
# Bloques de espera antes de acreditar un barrido en Base. Vacío: 10 (unos 20 segundos).
CRYPTO_BASE_CONFIRMATIONS=

# Pagos en Bitcoin on-chain (ADR-0063). El servidor solo tiene la llave pública de la cuenta: no puede mover nada.
# Sin xpub, `APP_ENV=development` muestra una dirección de ejemplo y deja simular el pago.
#
# La zpub (o xpub) de una cuenta BIP84 dedicada solo a cheapllm.wtf, como la exporta Sparrow o tu hardware wallet.
# Nunca una xprv/zprv. `pnpm payments:status` muestra la primera dirección: compárala con la de tu wallet.
CRYPTO_BITCOIN_XPUB=
# `testnet4` o `signet` para probar (con una tpub o vpub). Vacío: mainnet.
CRYPTO_BITCOIN_NETWORK=
# Una API Esplora propia. Vacío: mempool.space de la red elegida.
CRYPTO_BITCOIN_ESPLORA_URL=
# Confirmaciones antes de acreditar. Vacío: 1. Nunca 0.
CRYPTO_BITCOIN_CONFIRMATIONS=
