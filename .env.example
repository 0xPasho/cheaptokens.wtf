# Copia este archivo a .env.local. Nunca se versiona .env.local.

# Postgres (ADR-0032). En local, `pnpm db:dev` levanta PGlite en este puerto.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# development | preview | production. En Vercel se usa VERCEL_ENV.
APP_ENV=development

# Key de InferHub solo para cheaptokens.wtf (ADR-0028). Opcional fuera de producción: sin ella se usa el mock.
UPSTREAM_INFERHUB_API_KEY=

# Upstream simulado (`pnpm mock:upstream`). Nunca en producción.
UPSTREAM_MOCK_BASE_URL=http://127.0.0.1:4010/v1

# Lo usa `pnpm catalog:sync` para revalidar el catálogo. Mínimo 16 caracteres.
INTERNAL_REVALIDATE_SECRET=

# Host del gateway en producción (api.cheaptokens.wtf). Vacío: cualquier host.
API_HOST=

# Rate limit global por workspace, requests por minuto (ADR-0017).
GATEWAY_RATE_LIMIT_RPM=60
