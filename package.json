{
  "name": "cheaptokens.wtf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:gateway && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "test:e2e:update": "next build && playwright test --update-snapshots",
    "test:gateway": "vitest run --config vitest.gateway.config.mts --passWithNoTests",
    "test:live": "vitest run --config vitest.live.config.mts --passWithNoTests",
    "db:dev": "tsx scripts/db-dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "mock:upstream": "tsx scripts/mock-upstream.ts",
    "catalog:sync": "tsx scripts/sync-catalog.ts",
    "keys:create": "tsx scripts/keys-create.ts",
    "credits:grant": "tsx scripts/credits-grant.ts",
    "reconcile": "tsx scripts/reconcile.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
